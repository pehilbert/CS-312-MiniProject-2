<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cocktail Explorer</title>
    <link rel="stylesheet" href="/stylesheets/index.css">
</head>
<body>
    <% if (locals.cocktail) { %>
        <div class="details-container">
            <h1 class="details-title"><%= locals.cocktail.name %></h1>
            <% if (locals.cocktail.thumbnail) { %>
                <img class="details-thumbnail" src="<%= locals.cocktail.thumbnail %>"/>
            <% } %>
            <p class="details-category"><%= locals.cocktail.alcoholic %>, <%= locals.cocktail.category %></p>
            <% if (locals.cocktail.iba) { %>
                <p><b>IBA: <%= locals.cocktail.iba %></b></p>
            <% } %>  
            <% if (locals.cocktail.tags) { %>
                <div class="details-tag-container">
                    <% locals.cocktail.tags.forEach(tag => { %>
                        <p class="details-tag"><%= tag %></p>
                    <% }) %>
                </div>
            <% } %>
            <h3 class="details-make">Want to make this cocktail?</h3>
            <h4 class="details-instructions-title">Ingredients</h4>
            <ul>
                <% locals.cocktail.ingredients.forEach(ingredient => { %>
                    <li class="details-instructions"><%= ingredient %></li>
                <% }) %>
            </ul>
            <h4 class="details-instructions-title">Instructions</h4>
            <p class="details-instructions"><%= locals.cocktail.instructions %></p>
            <% if (locals.cocktail.videoLink) { %>
                <a class="details-video-link" href="<%= locals.cocktail.videoLink %>">Link to tutorial video</a>
            <% } %>
        </div>
    <% } else { %>
        <div class="details-container">
            <h1>Something went wrong.</h1>
        </div>
    <% } %>
</body>
</html>
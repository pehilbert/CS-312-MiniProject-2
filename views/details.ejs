<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= locals.cocktail ? cocktail.name + " Details" : "Cocktail Explorer" %></title>
    <link rel="stylesheet" href="/stylesheets/index.css">
</head>
<body>
    <% if (locals.cocktail) { %>
        <div class="details-container">
            <h1><%= locals.cocktail.name %></h1>
            <% if (locals.cocktail.thumbnail) { %>
                <img class="details-thumbnail" src="<%= locals.cocktail.thumbnail %>"/>
            <% } %>
            <p><%= locals.cocktail.alcoholic %>, <%= locals.cocktail.category %></p>
            <% if (locals.cocktail.iba) { %>
                <p><b>IBA: <%= locals.cocktail.iba %></b></p>
            <% } %>  
            <% if (locals.cocktail.tags) { %>
                <div class="details-tag-container">
                    <% locals.cocktail.tags.forEach(tag => { %>
                        <p class="details-tag"><%= tag %></p>
                    <% }) %>
                </div>
            <% } %>
            <h3>Want to make this cocktail?</h3>
            <p>Glass needed: <%= locals.cocktail.glass %></p>
            <h4>Ingredients</h4>
            <ul>
                <% locals.cocktail.ingredients.forEach(ingredient => { %>
                    <li><%= ingredient %></li>
                <% }) %>
            </ul>
            <h4>Instructions</h4>
            <p><%= locals.cocktail.instructions %></p>
            <% if (locals.cocktail.videoLink) { %>
                <a href="<%= locals.cocktail.videoLink %>">Link to tutorial video</a>
            <% } %>
        </div>
    <% } else if (locals.error) { %>
        <h2 class="main-title"><%= locals.error %></h2>
    <% } else { %>
        <h2 class="main-title">Something went wrong.</h2>
    <% } %>
</body>
</html>